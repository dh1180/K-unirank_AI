# Local clone ONLY. Spring API URL is operator controlled, never user supplied.
SPRING_API_BASE_URL=http://127.0.0.1:8080
# Mandatory private service-to-service credential, use a random high-entropy value.
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
SPRING_API_TIMEOUT_SECONDS=8
MAX_AI_CONCURRENCY=8
